# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These identify your project; they are not secrets, but keep them in env vars.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Invite-only: comma-separated Google emails allowed to sign in.
ALLOWED_EMAILS=

# Optional: link to the shared Apps Script engine template shown on the Setup page.
NEXT_PUBLIC_ENGINE_TEMPLATE_URL=

# Optional monitoring (daily Vercel Cron → /api/cron/monitor). CRON_SECRET: any long random
# string; Vercel sends it to the cron route. RESEND_API_KEY + ALERT_FROM: email stale-engine alerts.
CRON_SECRET=
RESEND_API_KEY=
ALERT_FROM=
